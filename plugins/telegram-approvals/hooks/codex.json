{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/telegram_hook.py\"",
            "timeout": 330,
            "statusMessage": "Waiting for Telegram approval"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/telegram_hook.py\"",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  }
}
